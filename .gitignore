# ======================================================================
# .gitignore  –  Reglas para Qwen-Widget / OpenClaw
# Asegura que ningún dato personal, log o archivo temporal se suba a GitHub
# ======================================================================

# Credenciales, tokens y variables de entorno
.env
.env.*
*.secret
*.token
*.key
*credential*
*credentials*
*private*
*.pem

# Archivos de log y temporales
*.log
/tmp/
*.tmp
*.temp
*~
*.swp
*.swo
.cache/

# Capturas de pantalla y medios personales
captura_*.png
Capturas/
capturas/
screenshots/
qwen_image.jpg
sync-to-github.sh

# Compilación, paquetes y binarios locales
build/
dist/
lib/native/
bin/lua5.3
bin/llama-server
bin/qwen-widget-bin
lua-*/
*.o
*.a
*.so
*.so.*
*.deb
*.tar.gz
*.pkg.tar.zst
*.exe
*.dmg
*.pkg
luac.out
__pycache__/
*.pyc
models/*.gguf
models/*.part
*.gguf
*.bin

# Artefactos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores y entornos de desarrollo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
